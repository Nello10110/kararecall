# Copier ce fichier en .env sur le homelab. Ne jamais committer .env.
# Les valeurs restent sur votre machine. Aucun fournisseur n’est imposé.
COMPOSE_PROJECT_NAME=kararecall
COMPOSE_PROFILES=
KARARECALL_BIND_ADDRESS=127.0.0.1
KARARECALL_PORT=8765
KARARECALL_USERNAME=admin
KARARECALL_PASSWORD=change-me-before-start
KARARECALL_VOLUME_NAME=kararecall-storage
PUID=10001
PGID=10001

# Collecte Karakeep en lecture seule. URL du serveur, sans /api/v1.
# Activer COMPOSE_PROFILES=automation et SYNC_ENABLED=true pour la boucle.
SYNC_ENABLED=false
KARAKEEP_BASE_URL=
KARAKEEP_API_KEY=
# Vide = tous les favoris, sites, articles, notes et fichiers inclus.
KARAKEEP_URL_FILTER=
# Noms de tags séparés par des virgules ; vide = pas de filtre par tag.
KARAKEEP_TAG_FILTER=
SYNC_INTERVAL_SECONDS=900
DOWNLOAD_MEDIA=true
# Réutiliser une piste de sous-titres textuels complète avant de demander l’ASR.
REUSE_SUBTITLES=false
PDF_MAX_PAGES=25
# Envoyer un aperçu des pages PDF sans texte au service vision configuré.
PDF_OCR_ENABLED=false
PDF_OCR_MAX_PAGES=3
# Autoriser l’envoi des images autonomes au service vision configuré.
IMAGE_OCR_ENABLED=false

# Recherche et lecture de pages via DeepSeek. Activable après le premier import.
WEB_RESEARCH_ENABLED=false
DEEPSEEK_RESEARCH_API_KEY=
WEB_REQUEST_USD=0.00075
WORKER_BATCH_SIZE=3
MEDIA_MAX_MB=100
STORAGE_MIN_FREE_MB=256
MEDIA_MAX_SECONDS=300
HTTP_TIMEOUT_SECONDS=120

# Rédaction des fiches : endpoint compatible /v1/chat/completions.
# Ex. Ollama sur le Mac : http://ADRESSE_DU_MAC:11434/v1
# Le modèle doit déjà être disponible sur ce serveur.
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_INPUT_CHARS=24000
# 0 = synthèse simple ; jusqu’à 10 résumés de passages pour les documents longs.
LLM_DOCUMENT_SECTIONS=0

# Transcription optionnelle via /v1/audio/transcriptions (verbose_json).
# Laisser le modèle vide pour ne pas envoyer d’audio à un service.
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=

# Vision optionnelle via chat/completions multimodal.
# URL/clé vides : utilise celles du LLM. Modèle vide : aucun envoi d’image.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_INTERVAL_SECONDS=5
VISION_MAX_FRAMES=12
# regular = répartition uniforme ; changes = priorité aux changements visuels locaux.
VISION_SAMPLE_MODE=regular

# Fiabilité et limites pour environ 20 vidéos/mois.
WORKER_MAX_ATTEMPTS=3
LLM_MAX_OUTPUT_TOKENS=2000
VISION_MAX_OUTPUT_TOKENS=600
# Vides = ne pas envoyer ce paramètre ; le profil API les règle sur none.
LLM_REASONING_EFFORT=
VISION_REASONING_EFFORT=
# DeepSeek : disabled désactive le raisonnement ; vide = paramètre non envoyé.
LLM_THINKING=
VISION_THINKING=
AI_TOKEN_LIMIT_PARAM=max_completion_tokens
ASR_SEGMENT_TIMESTAMPS=true
AI_MONTHLY_BUDGET_USD=2.00
AI_CALL_RESERVE_USD=0.05
AI_MAX_CALLS_PER_DAY=50
AI_MAX_CALLS_PER_MONTH=400
# Tarifs USD à vérifier chez le fournisseur. 0 = inconnu : réserve entière conservée.
LLM_INPUT_USD_PER_MILLION=0
LLM_OUTPUT_USD_PER_MILLION=0
VISION_INPUT_USD_PER_MILLION=0
VISION_OUTPUT_USD_PER_MILLION=0
ASR_USD_PER_HOUR=0
